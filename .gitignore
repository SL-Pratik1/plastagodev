# Dependencies
node_modules/

# Build output
dist/
build/
dev-dist/
*.tsbuildinfo

# Turborepo
.turbo/

# Local stub file storage (STORAGE_STUB_DIR) — runtime uploads, not source.
#
# Unanchored, so it catches every copy rather than one path. The old rule named
# `apps/api/.storage/` alone, and the two it did not name — `.storage/` at the
# repo root and the per-environment `.storage-qa/` — were committed for months:
# invoice PDFs, job photos and delivery dockets, in a source repository.
.storage/
.storage-*/

# NOTE: apps/api/openapi/openapi.json IS committed on purpose.
# It is the published contract the Flutter repo pins a version of (§6A.5), and
# CI fails the build if the committed copy is stale. Generated, but tracked.

# Environment — NEVER commit real credentials
.env
.env.*
!.env.example

# Test / coverage
coverage/
*.lcov

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Local-only docs
docs/driver-handover/

# TransVirtual migration inputs/outputs — real customer data, never committed.
# The scripts that read/write it live in apps/api/src/scripts/ (tracked).
apps/api/migration-data/

# Throwaway probes. A script written to answer one question on one machine —
# "is the webhook registered", "what did the extractor return" — is not part of
# the product, and committing one leaves the next person guessing whether it is
# still needed. Name them `tmp-*` and they stay local.
apps/*/src/scripts/tmp-*.ts
scripts/tmp-*.mjs

# Playwright — the end-to-end suite stays local, by request. The specs drive a
# real browser against a seeded database and a running API, which is a thing to
# run on a laptop rather than to publish alongside four deploy repos.
# ⚠️ package.json still declares @playwright/test and the e2e:* scripts, so a
# fresh clone installs the runner and finds no specs. Remove those too if the
# suite is meant to be gone rather than merely unpublished.
e2e/
playwright.config.ts
scripts/e2e.mjs
