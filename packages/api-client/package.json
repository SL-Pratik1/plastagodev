{
  "name": "@plastago/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed, schema-parsing HTTP client shared by the web app and the driver PWA",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@plastago/shared": "*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
