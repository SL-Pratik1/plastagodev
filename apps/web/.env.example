# Client-side env. Vite inlines every VITE_* value into the bundle —
# treat everything here as PUBLIC. Secrets belong on the API only.

# Empty = same origin, which is what the dev proxy and production both want.
VITE_API_BASE_URL=

# Set to "true" to serve the app entirely from MSW mock data (days 1–3, §13.2).
# Run `npx msw init public --save` once first to install the service worker.
VITE_ENABLE_MOCKS=false

# ─── The surface split (§6A.5 · M4 · Matt, 29:04) ───────────────────────────
#
# Three surfaces, three addresses:
#
#   console.plastago.com.au   /admin     the office
#   portal.plastago.com.au    /portal    customers
#   drivers.plastago.com.au   /driver    drivers
#
# Matt asked for it so a driver standing on a building site never sees an office
# sign-in screen: "maybe it's an idea to split the driver section off into a
# separate login screen… if I need to do multiple subdomains, I'm happy to do
# that." The same argument separates the customer portal from the console.
#
# Locally the three are ports rather than hostnames. ⚠️ A port is NOT an origin
# for cookies — browsers ignore the port, so the surfaces share a session here
# and will not in production. See scripts/dev-ports.mjs.

# Which servers `npm run dev` starts. "all" = one server, every surface, on the
# admin port: faster to boot, and how the app worked before the split.
PLASTAGO_SURFACES=admin,portal,driver

# Move these to run a second checkout alongside this one. Defaults shown.
# PLASTAGO_PORT_ADMIN=5173
# PLASTAGO_PORT_PORTAL=5175
# PLASTAGO_PORT_DRIVER=5176

# Where each surface lives. EMPTY in development — the localhost origins implied
# by the ports above are correct, and hard-coding them here is how they drift.
# Production names the real hostnames.
VITE_ADMIN_APP_URL=
VITE_PORTAL_APP_URL=
VITE_DRIVER_APP_URL=

# Google Maps Embed API key (I3) — enables the in-app navigation map.
# Empty = the driver hands off to their phone maps app instead, which is the
# behaviour without credentials. Needs a BILLED key with Maps Embed API on.
VITE_GOOGLE_MAPS_EMBED_KEY=

# I6 · M2.12 — the 3PM Extractor's base URL, for the embedded Extractor tab.
# PUBLIC: it ends up in the iframe src. The embed token does NOT belong here —
# the API brokers a one-day session id instead (see apps/api EXTRACTOR_*).
# Leave blank and the tab says it is not configured rather than rendering an
# empty frame.
VITE_EXTRACTOR_URL=
