# Client-side env. Vite inlines every VITE_* value into the bundle —
# treat everything here as PUBLIC. Secrets belong on the API only.

# Empty = same origin, which is what the dev proxy and production both want.
VITE_API_BASE_URL=

# Set to "true" to serve the app entirely from MSW mock data (days 1–3, §13.2).
# Run `npx msw init public --save` once first to install the service worker.
VITE_ENABLE_MOCKS=false

# The driver app's own origin (M4 · Matt, 29:04).
#
# Drivers sign in at drivers.plastago.com.au, the office and customers at
# portal.plastago.com.au. Matt asked for the split so a driver standing on a
# building site never sees an office sign-in screen: "maybe it's an idea to split
# the driver section off into a separate login screen… if I need to do multiple
# subdomains, I'm happy to do that."
#
# Leave EMPTY in development, where the driver screens are served from this app
# at /driver and there is no second origin to send anyone to.
VITE_DRIVER_APP_URL=

# Google Maps Embed API key (I3) — enables the in-app navigation map.
# Empty = the driver hands off to their phone maps app instead, which is the
# behaviour without credentials. Needs a BILLED key with Maps Embed API on.
VITE_GOOGLE_MAPS_EMBED_KEY=
