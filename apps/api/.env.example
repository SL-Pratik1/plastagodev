# ─── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ─── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated allowlist. 5173 = web app, 5174 = driver PWA. Never "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── MongoDB (§6A.2 — Atlas ap-southeast-2 / Sydney in every deployed env) ──────
# Local standalone is fine for scaffolding, but note: multi-document
# transactions (§6A.3 #3) need a replica set. Use Atlas or a local replica set
# before building the invoicing domain.
MONGODB_URI=mongodb://127.0.0.1:27017/plastago_dev
# MONGODB_DB_NAME=plastago_dev

# ─── Redis / BullMQ ─────────────────────────────────────────────────────────────
# Off by default so the API boots without Redis installed. Turn on once Redis
# is running locally; always "true" in deployed environments.
ENABLE_QUEUES=false
REDIS_URL=redis://127.0.0.1:6379

# ─── Rate limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ─── I9 · Object storage — photos, weighbridge dockets, PO documents ──────────
# Leave STORAGE_PROVIDER unset for local work: the stub writes to ./.storage and
# the whole capture-and-view path works with no AWS account. Production refuses
# to boot on the stub — local disk does not survive a container restart.
# STORAGE_PROVIDER=s3
# S3_BUCKET=
# S3_REGION=ap-south-1
# The one folder everything lives under: plastago/jobs/<id>/photos/<uuid>.jpg
# Defaults to `plastago`. Give staging its own value to share a bucket safely.
# S3_KEY_PREFIX=plastago
# Omit both on EC2/ECS so the SDK uses the instance role. Set both or neither —
# half a pair fails at boot rather than at the moment a driver uploads a photo.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ─── Not yet wired — add as each integration lands (§8) ─────────────────────────
# Authentication, email (I5/I6 Graph) and SMS (I2) are configured further down.
# MISTRAL_API_KEY=           # I8 — superseded by the 3PM Extractor (see below)
# GOOGLE_MAPS_API_KEY=       # I3 — the frontend key lives in apps/web/.env

# ─── I1 · M7.8 — Xero ───────────────────────────────────────────────────────────
# "off" is a WORKING state, not a broken one: invoices are raised exactly as
# they are today and every sync badge reads "Not sent to Xero".
XERO_PROVIDER=off

# ⚠️ Unlike every other integration here, credentials are NOT enough. Xero has
# no static key to a company's ledger — the organisation owner authorises
# PlastaGo from a browser, once, on the admin Xero page. These only identify
# the APPLICATION.
#
# From developer.xero.com → My Apps → (your app) → Configuration. Create it as
# a "Web app"; a Custom Connection cannot do this and is locked to one org.
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=

# ⚠️ Must match a redirect URI registered on the Xero app EXACTLY — Xero
# compares the whole string, scheme and trailing slash included, and answers a
# mismatch with `invalid_grant`. Xero permits http for localhost.
# Defaults to AUTH_BASE_URL + /api/v1/xero/callback when unset.
# XERO_REDIRECT_URI=http://localhost:4000/api/v1/xero/callback

# Encrypts the Xero refresh token at rest (AES-256-GCM). 64 hex characters.
# Required when XERO_PROVIDER=xero — a customer's grant over their own
# accounting records is not written to Mongo in clear text.
# ⚠️ Rotating this does not corrupt anything, but the stored connection can no
# longer be read: the page says "reconnect" and the owner reconnects once.
# Generate with: openssl rand -hex 32
# XERO_ENCRYPTION_KEY=

# What a pushed invoice BECOMES in Xero.
#   DRAFT      — lands in Xero's draft list; the accountant approves it there.
#   AUTHORISED — live in the books immediately, with nothing in between.
# ⚠️ This is the client's accountant's decision, not a technical one. DRAFT
# until they say otherwise: AUTHORISED means an invoice PlastaGo got wrong is
# already a real accounting document.
XERO_INVOICE_STATUS=DRAFT

# ─── Authentication (§9, M1.5) ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# The development default in env.ts is REJECTED when NODE_ENV=production.
# BETTER_AUTH_SECRET=
AUTH_BASE_URL=http://localhost:4000
AUTH_SESSION_TTL_HOURS=8

OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=6

# "true"  — an unknown identifier answers IDENTIFIER_UNKNOWN, so the
#           "we don't recognise that" screen is walkable. Also an
#           enumeration oracle.
# "false" — every request looks identical and nothing is sent.
# Forced OFF in production whatever this says.
AUTH_REVEAL_UNKNOWN_IDENTIFIER=true

# ⚠️ Returns the sign-in code in the POST /auth/otp/request response.
#
# For a SHARED environment running stub mail and SMS, where the code only
# reaches the server log — a client developer working against it otherwise
# cannot sign in without dashboard access to someone else's hosting account.
#
# While this is on the code is NOT a second factor: anyone who can name an
# identifier can sign in as that person. Forced OFF in production whatever
# this says. Turn it off again the moment the real providers are wired.
AUTH_REVEAL_OTP_CODE=false

# ─── Outbound channels ──────────────────────────────────────────────────────────
# "stub" prints the code to the API log — no vendor account needed.
# Neither may be "stub" in production; env.ts refuses to boot.
MAIL_PROVIDER=stub
SMS_PROVIDER=stub
OTP_SENDER_NAME=PlastaGo

# Where an invitation, a reminder or an invoice notice sends people to sign in.
# Must be the address the customer actually uses — it is printed into messages
# that cannot be corrected once sent. No trailing slash.
PUBLIC_APP_URL=http://localhost:5173

# I5 — outbound mail only. `Mail.Send`, nothing more.
#
# ⚠️ `Mail.Read` is NOT needed here any more. The PO pipeline (M2.12 · I6) reads
# the mailbox through the 3PM Extractor, which owns that connection — so the
# consent lives with the vendor that needs it and this registration stays
# send-only. See EXTRACTOR_* below.
#
# Ask the client's IT to add an Application Access Policy limiting the app to
# the specific mailboxes, or the grant covers every mailbox in the tenant and
# they will rightly refuse.
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_MAIL_SENDER=noreply@plastago.com.au

# I2 — SMS. This is how drivers and site supervisors sign in (§9 A2), so a
# failure here is a failure to let somebody start work.
#
# ⚠️ Three account-level things that are NOT code and will each silently break
# every driver sign-in until they are done in the Twilio console:
#   1. A TRIAL account only messages numbers verified in the console.
#   2. Geo permissions must have AUSTRALIA enabled, or sends fail with 21408.
#   3. A US (+1) long code reaches Australian handsets unreliably and needs
#      A2P 10DLC registration. Prefer a +61 number or an approved
#      alphanumeric sender id.
#
# Mobiles are stored in local form (0412345678) and converted to E.164 by the
# Twilio provider itself — see `integrations/twilio-sms.ts`.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# ─── I6 · M2.12 — the purchase-order extractor (3PM Extractor) ──────────────────
# "off" is a WORKING state, not a broken one: the review queue still accepts
# extractions posted by hand, and the office keys purchase orders in as it does
# today. Switching the pipeline on is this variable plus its credentials.
EXTRACTOR_PROVIDER=off

# EXTRACTOR_BASE_URL=https://extractor.decoded.digital
#
# From the extractor's Admin Dashboard → Applications. The secret is shown once
# and NEVER reaches a browser — it is exchanged for a one-day session server-side.
#
# ⚠️ THIS FILE IS COMMITTED. Real values belong in `.env`, which is gitignored.
# EXTRACTOR_APP_ID=
# EXTRACTOR_APP_SECRET=
#
# From `npm run setup:extractor -w @plastago/api -- --onboard`. Also shown once.
# EXTRACTOR_EMBED_TOKEN=
#
# The identity sessions are minted for. A service address, not a person's — a
# session under someone's own email attributes every ingested PO to them.
# EXTRACTOR_USER_EMAIL=platform@plastago.com.au
#
# From `npm run setup:extractor -w @plastago/api`. Without it the webhook accepts
# every completed extraction in the tenant, including other document types.
# EXTRACTOR_DOCUMENT_ID=
#
# M2.12b — the template for CALL-UP emails, the second document type in the same
# mailbox. Matt, 23:37: "all purchase orders and call-ups will go to the same
# email address", so the template is the only thing telling them apart.
#
# ⚠️ Until this is set, NO call-up is ever read from an email. That is the safe
# default: without it a call-up would be read against the purchase-order
# template and arrive in the review queue as an order with no figures on it.
# Booking by hand works either way — Admin > Queues > Waiting for a date.
#
# Needs a template with fields: po_number, ready_date, notification_type,
# site_address, note.
# EXTRACTOR_CALL_UP_DOCUMENT_ID=
#
# Shared secret on the callback URL. Generate: openssl rand -hex 32
# ⚠️ It authenticates the PING, not the payload — the webhook body is never
# trusted, and the handler re-fetches the document with our own credentials. So
# the worst a leak achieves is making us re-read our own documents.
# EXTRACTOR_WEBHOOK_SECRET=
