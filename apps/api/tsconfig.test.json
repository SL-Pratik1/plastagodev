{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"],
    // Tests and the vitest config are never emitted, so they sit outside the
    // build's `rootDir` and are typechecked separately.
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
