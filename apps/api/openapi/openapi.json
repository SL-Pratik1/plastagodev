{
  "openapi": "3.1.0",
  "info": {
    "title": "PlastaGo API",
    "version": "1.0.0",
    "description": "Contract shared by the admin console, customer portal, driver PWA and the Flutter driver app. Generated from Zod schemas — do not hand-edit."
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local development"
    },
    {
      "url": "https://api.plastago.com.au",
      "description": "Production (placeholder)"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Liveness and readiness probes"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "getLiveness",
        "summary": "Liveness probe",
        "description": "Cheap, dependency-free. Used by the platform to decide on a restart.",
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "getReadiness",
        "summary": "Readiness probe",
        "description": "Checks Mongo and Redis. Returns 503 while any required dependency is down.",
        "responses": {
          "200": {
            "description": "Ready to serve traffic",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "One or more dependencies unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Liveness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "uptimeSeconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "uptimeSeconds"
        ],
        "additionalProperties": false
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "degraded"
            ]
          },
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "dependencies": {
            "type": "object",
            "properties": {
              "mongo": {
                "$ref": "#/components/schemas/DependencyCheck"
              },
              "redis": {
                "$ref": "#/components/schemas/DependencyCheck"
              }
            },
            "required": [
              "mongo",
              "redis"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "checkedAt",
          "dependencies"
        ],
        "additionalProperties": false
      },
      "DependencyCheck": {
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/DependencyState"
          },
          "latencyMs": {
            "type": "number",
            "minimum": 0
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "state"
        ],
        "additionalProperties": false
      },
      "DependencyState": {
        "type": "string",
        "enum": [
          "up",
          "down",
          "disabled"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Short-lived access token issued after OTP verification."
      }
    }
  }
}
