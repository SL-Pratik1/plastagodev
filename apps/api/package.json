{
  "name": "@plastago/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express + BullMQ service — one API, plus worker processes (§6A.1)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "tsx src/scripts/generate-openapi.ts",
    "clean": "rm -rf dist .turbo coverage openapi/openapi.json *.tsbuildinfo",
    "seed:auth": "tsx src/scripts/seed-auth.ts",
    "seed:settings": "tsx src/scripts/seed-settings.ts",
    "seed:places": "tsx src/scripts/seed-places.ts",
    "seed:driver-demo": "tsx src/scripts/seed-driver-demo.ts",
    "setup:extractor": "tsx src/scripts/setup-extractor.ts",
    "seed:reset": "tsx src/scripts/seed-reset.ts",
    "migrate:rate-schedules": "tsx src/scripts/migrate-rate-schedules.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "seed:all": "npm run seed:reset && npm run seed:auth && npm run seed:settings && npm run seed:places && npm run seed:demo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@azure/identity": "^4.13.2",
    "@plastago/shared": "*",
    "better-auth": "^1.7.3",
    "bullmq": "^6.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "mongodb": "~7.5.0",
    "mongoose": "^9.9.3",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "twilio": "^6.1.0",
    "zod": "^4.4.3",
    "zod-openapi": "^6.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
