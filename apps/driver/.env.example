# Client-side env — every VITE_* value is inlined into the bundle. Public only.

# Empty = same origin, which the dev proxy and production both want.
VITE_API_BASE_URL=

# Google Maps Embed API key (I3) — enables the in-app navigation map.
# Empty = the driver hands off to their phone maps app instead, which is the
# behaviour without credentials. Needs a BILLED key with Maps Embed API on.
VITE_GOOGLE_MAPS_EMBED_KEY=

# ⚠️ SUPERSEDED — the driver screens live in apps/web on their own origin. This
# app is excluded from `npm run dev`; `npm run dev:driver` starts it on its own.
# PLASTAGO_PORT_LEGACY_DRIVER=5174
